# Supabase configuration (for future family/cloud sync)
# Copy this file to .env and fill in your project values
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Aladhan API (no key required for free tier)
VITE_ALADHAN_API_BASE=https://api.aladhan.com/v1

# Quran.com API
VITE_QURAN_API_BASE=https://api.quran.com/api/v4

# EveryAyah audio base
VITE_EVERYAYAH_BASE=https://everyayah.com/data
